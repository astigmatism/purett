<div id="loading"></div>

<div id="error" class="rel"></div>

<div id="reportbug" class="rel">
    <div class="close abs"></div>
    <div>
        Please describe the bug with as much detail as possible. If you are presently playing a game, the game details will be automatically included.
    </div>
    <textarea></textarea>
    <div class="send">SEND</div>
</div>

<div id="feedback" class="rel">
    <div class="close abs"></div>
    <div>
        All suggestions, questions, and general feedback welcome!
    </div>
    <textarea></textarea>
    <div class="send">SEND</div>
</div>

<div id="changecolor" class="rel">
    <div class="close abs"></div>
    <div>
        Please select the deck color you would like to use:
    </div>
    <div class="colorselect">
    </div>
    <div>
        Purchase more deck colors from the shop!
    </div>
</div>

<div id="contextmenu" class="rel">
    <div class="close abs"></div>
    <ul class="menu">
        <li class="main">Main Menu</li>
        <li class="review">Review Game</li>
        <li class="changecolor enabled" rel="#changecolor">Deck Color</li>
        <li class="content-scale enabled">
            <span>Game Size</span>
            <div class="content-scale-options" role="group" aria-label="Game size">
                <button type="button" data-scale="1" aria-pressed="false">1&times;</button>
                <button type="button" data-scale="1.5" aria-pressed="false">1.5&times;</button>
                <button type="button" data-scale="2" aria-pressed="false">2&times;</button>
                <button type="button" data-scale="3" aria-pressed="false">3&times;</button>
            </div>
        </li>
        <li class="graphics-mode enabled">
            <span>Graphics</span>
            <div class="graphics-mode-options" role="group" aria-label="Graphics mode">
                <button type="button" data-graphics-mode="legacy" aria-pressed="false">Legacy</button>
                <button type="button" data-graphics-mode="modern" aria-pressed="false">Modern</button>
            </div>
            <div class="graphics-mode-status" aria-live="polite"></div>
        </li>
        <li class="motion-studio enabled">
            <button type="button">Motion Studio&hellip;</button>
        </li>
        <li class="enabled feedback" rel="#feedback">Feedback</li>
        <li class="enabled reportbug" rel="#reportbug">Report a Bug</li>
        <li class="enabled account"><a href="/account">Account Settings</a></li>
        <li class="enabled logout">Log Out</li>
    </ul>
</div>

<section
    id="motionstudio"
    class="motion-studio"
    role="dialog"
    aria-modal="true"
    aria-labelledby="motionstudio-title"
    aria-hidden="true"
    tabindex="-1"
>
    <div class="motion-studio-scale-stage">
        <div class="motion-studio-shell">
        <section class="motion-studio-preview-panel" aria-label="Motion preview">
            <div id="motionstudio-preview" class="motion-studio-preview">
                <div id="motionstudio-canvas-host" aria-hidden="true"></div>
                <svg
                    class="motion-studio-helpers"
                    viewBox="0 0 755 562"
                    preserveAspectRatio="none"
                    aria-hidden="true"
                >
                    <g class="motion-studio-destination motion-studio-marker-destination">
                        <rect
                            class="motion-studio-card-destination"
                            x="-58.5"
                            y="-73"
                            width="117"
                            height="146"
                            rx="4"
                            ry="4"
                        ></rect>
                        <circle
                            class="motion-studio-coin-destination"
                            r="20.5"
                        ></circle>
                    </g>
                    <path class="motion-studio-path" d=""></path>
                    <line class="motion-studio-skid-path"></line>
                    <g class="motion-studio-marker motion-studio-marker-start">
                        <circle r="8"></circle>
                        <text x="12" y="4">START</text>
                    </g>
                    <g class="motion-studio-marker motion-studio-marker-apex">
                        <circle r="6"></circle>
                        <text x="10" y="4">APEX</text>
                    </g>
                    <g class="motion-studio-marker motion-studio-marker-contact">
                        <circle r="7"></circle>
                        <text x="11" y="-10">CONTACT</text>
                    </g>
                    <g class="motion-studio-marker motion-studio-marker-land">
                        <rect x="-7" y="-7" width="14" height="14"></rect>
                        <text x="11" y="20">LOCKED TARGET</text>
                    </g>
                </svg>
                <div class="motion-studio-preview-hint">
                    Drag <strong>START</strong>; the application target is locked
                </div>
                <div class="motion-studio-loading" role="status">Preparing Three.js preview&hellip;</div>
            </div>
        </section>

        <div class="motion-studio-dock">
            <header class="motion-studio-header">
                <button type="button" class="motion-studio-back">&larr; Back to Lobby</button>
                <div class="motion-studio-heading">
                    <strong id="motionstudio-title">Motion Studio</strong>
                    <span>Lobby card animation playbook</span>
                </div>
                <label class="motion-studio-target-label" for="motionstudio-target">
                    Application animation
                    <select id="motionstudio-target">
                        <optgroup label="Lobby intros">
                            <option value="lobby-card-1-intro">Lobby card 1 — Intro</option>
                            <option value="lobby-card-2-intro">Lobby card 2 — Intro</option>
                            <option value="lobby-card-3-intro">Lobby card 3 — Intro</option>
                            <option value="lobby-card-4-intro">Lobby card 4 — Intro</option>
                            <option value="lobby-card-5-intro">Lobby card 5 — Intro</option>
                        </optgroup>
                        <optgroup label="Lobby exits">
                            <option value="lobby-hand-gentle-wind-exit">Lobby hand — Gentle Wind Exit</option>
                        </optgroup>
                        <optgroup label="Active match studies">
                            <option value="match-turn-coin-transition">Match turn coin — Transition</option>
                        </optgroup>
                    </select>
                </label>
                <label
                    class="motion-studio-coin-direction-label"
                    for="motionstudio-coin-direction"
                >
                    Preview direction
                    <select id="motionstudio-coin-direction">
                        <option value="player-to-opponent">Player &rarr; AI</option>
                        <option value="opponent-to-player">AI &rarr; Player</option>
                    </select>
                </label>
                <label class="motion-studio-preset-label" for="motionstudio-preset">
                    Starting motion
                    <select id="motionstudio-preset">
                        <option value="gentle-drop">Gentle Drop</option>
                        <option value="casual-toss" selected>Casual Toss</option>
                        <option value="energetic-scatter">Energetic Scatter</option>
                        <option value="custom">Custom</option>
                    </select>
                </label>
                <button type="button" class="motion-studio-reset">Reset target</button>
            </header>

            <div class="motion-studio-readout" aria-label="Live motion readout">
                <span><strong>Phase</strong> <output data-motion-readout="phase" aria-live="polite">Ready</output></span>
                <span><strong>Height</strong> <span data-motion-readout="height">0</span></span>
                <span><strong>Perspective</strong> <span data-motion-readout="perspectiveScale">1.00&times;</span></span>
                <span><strong>Art scale</strong> <span data-motion-readout="authoredScale">1.00&times;</span></span>
                <span><strong>Rendered</strong> <span data-motion-readout="renderedScale">1.00&times;</span></span>
                <span><strong>Face</strong> <span data-motion-readout="face">Front</span></span>
            </div>

            <aside class="motion-studio-inspector" aria-label="Motion parameters">
                <div class="motion-studio-inspector-tools">
                    <label>
                        <input type="checkbox" id="motionstudio-auto-replay" checked>
                        Auto replay
                    </label>
                    <label>
                        <input type="checkbox" id="motionstudio-show-helpers" checked>
                        Helpers
                    </label>
                </div>

                <section
                    class="motion-studio-intro-copy"
                    aria-label="Reuse intro motion settings"
                >
                    <strong>Reuse shared intro motion</strong>
                    <span>
                        Keeps each destination card&rsquo;s delay, heading,
                        distance, and curve.
                    </span>
                    <label for="motionstudio-copy-target">
                        Copy from this card to
                        <select id="motionstudio-copy-target">
                            <option value="">Choose lobby card&hellip;</option>
                            <option value="all">All other lobby intro cards</option>
                        </select>
                    </label>
                    <button type="button" class="motion-studio-copy-intro">
                        Copy settings
                    </button>
                </section>

                <div class="motion-studio-wind-tools">
                    <label>
                        <input type="checkbox" id="motionstudio-lock-wind-seed">
                        Lock wind seed
                    </label>
                    <button type="button" class="motion-studio-new-wind">
                        New variation
                    </button>
                    <output
                        id="motionstudio-wind-seed"
                        aria-label="Active wind variation seed"
                    ></output>
                </div>
                <div
                    class="motion-studio-control-status"
                    role="status"
                    aria-live="polite"
                ></div>

                <form id="motionstudio-controls">
                    <fieldset>
                        <legend>Sequence</legend>
                        <div data-motion-control-group="sequence"></div>
                    </fieldset>
                    <fieldset>
                        <legend>Travel</legend>
                        <div data-motion-control-group="path"></div>
                    </fieldset>
                    <fieldset>
                        <legend>Height &amp; scale</legend>
                        <label class="motion-studio-select-row" for="motionstudio-scale-mode">
                            <span>Scale mode</span>
                            <select id="motionstudio-scale-mode" data-motion-field="scale.mode">
                                <option value="perspective">Perspective</option>
                                <option value="keyframed">Keyframed</option>
                            </select>
                        </label>
                        <div data-motion-control-group="height"></div>
                        <div data-motion-keyframed-scale>
                            <div data-motion-control-group="keyframed-scale"></div>
                        </div>
                    </fieldset>
                    <fieldset>
                        <legend>Rotation</legend>
                        <div data-motion-control-group="rotation"></div>
                    </fieldset>
                    <fieldset>
                        <legend>Contact &amp; depth cues</legend>
                        <div data-motion-control-group="landing"></div>
                    </fieldset>
                </form>

                <details class="motion-studio-json">
                    <summary>Advanced playbook data</summary>
                    <textarea
                        id="motionstudio-json"
                        rows="10"
                        spellcheck="false"
                        aria-label="Lobby motion playbook JSON"
                    ></textarea>
                    <div class="motion-studio-json-actions">
                        <button type="button" class="motion-studio-copy">Export Playbook</button>
                        <button type="button" class="motion-studio-apply-json">Import Playbook</button>
                    </div>
                    <div class="motion-studio-json-status" role="status"></div>
                </details>
            </aside>

            <footer class="motion-studio-transport">
                <div class="motion-studio-transport-buttons">
                    <button type="button" class="motion-studio-apply-preview">
                        Apply &amp; Preview in Lobby
                    </button>
                    <button type="button" class="motion-studio-replay" title="Replay (R)">Replay</button>
                    <button type="button" class="motion-studio-play" title="Play or pause (Space)">Pause</button>
                    <button type="button" class="motion-studio-step-back" title="Previous frame">&larr; Frame</button>
                    <button type="button" class="motion-studio-step-forward" title="Next frame">Frame &rarr;</button>
                </div>
                <div class="motion-studio-timeline-wrap">
                    <input
                        id="motionstudio-timeline"
                        type="range"
                        min="0"
                        max="1000"
                        step="1"
                        value="0"
                        aria-label="Motion timeline"
                    >
                    <div class="motion-studio-timeline-markers" aria-hidden="true">
                        <span data-motion-marker="release">Release</span>
                        <span data-motion-marker="apex">Apex</span>
                        <span data-motion-marker="contact">Contact</span>
                        <span data-motion-marker="flat">Flat</span>
                        <span data-motion-marker="settled">Settled</span>
                    </div>
                </div>
                <output id="motionstudio-time">0 / 0 ms</output>
                <label for="motionstudio-speed">
                    Speed
                    <select id="motionstudio-speed">
                        <option value="0.25">0.25&times;</option>
                        <option value="0.5">0.5&times;</option>
                        <option value="1" selected>1&times;</option>
                        <option value="2">2&times;</option>
                    </select>
                </label>
                <label>
                    <input type="checkbox" id="motionstudio-loop" checked>
                    Loop
                </label>
            </footer>
        </div>
    </div>
    </div>
</section>
