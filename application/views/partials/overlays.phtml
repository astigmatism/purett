<div id="loading"></div>

<div id="error" class="rel"></div>

<div id="reportbug" class="rel">
    <div class="close abs"></div>
    <div>
        Please describe the bug with as much detail as possible. If you are presently playing a game, the game details will be automatically included.
    </div>
    <textarea></textarea>
    <div class="send">SEND</div>
</div>

<div id="feedback" class="rel">
    <div class="close abs"></div>
    <div>
        All suggestions, questions, and general feedback welcome!
    </div>
    <textarea></textarea>
    <div class="send">SEND</div>
</div>

<div id="changecolor" class="rel">
    <div class="close abs"></div>
    <div>
        Please select the deck color you would like to use:
    </div>
    <div class="colorselect">
    </div>
    <div>
        Purchase more deck colors from the shop!
    </div>
</div>

<div id="contextmenu" class="rel">
    <div class="close abs"></div>
    <ul class="menu">
        <li class="main">Main Menu</li>
        <li class="review">Review Game</li>
        <li class="changecolor enabled" rel="#changecolor">Deck Color</li>
        <li class="content-scale enabled">
            <span>Game Size</span>
            <div class="content-scale-options" role="group" aria-label="Game size">
                <button type="button" data-scale="1" aria-pressed="false">1&times;</button>
                <button type="button" data-scale="1.5" aria-pressed="false">1.5&times;</button>
                <button type="button" data-scale="2" aria-pressed="false">2&times;</button>
                <button type="button" data-scale="3" aria-pressed="false">3&times;</button>
            </div>
        </li>
        <li class="graphics-mode enabled">
            <span>Graphics</span>
            <div class="graphics-mode-options" role="group" aria-label="Graphics mode">
                <button type="button" data-graphics-mode="legacy" aria-pressed="false">Legacy</button>
                <button type="button" data-graphics-mode="modern" aria-pressed="false">Modern</button>
            </div>
            <div class="graphics-mode-status" aria-live="polite"></div>
        </li>
        <li class="enabled feedback" rel="#feedback">Feedback</li>
        <li class="enabled reportbug" rel="#reportbug">Report a Bug</li>
        <li class="enabled account"><a href="/account">Account Settings</a></li>
        <li class="enabled logout">Log Out</li>
    </ul>
</div>
